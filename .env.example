# ops-ng Phase 1 Environment Variables Template
# Copy to .env and update values as needed

# PostgreSQL
POSTGRES_USER=ops
POSTGRES_PASSWORD=devpassword123
POSTGRES_HOST=localhost
STRAPI_DB=strapi_db
HYDRA_DB=hydra_db

# Redis
REDIS_URL=redis://localhost:6379

# ORY Hydra
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445
HYDRA_SECRETS_SYSTEM=youReallyNeedToChangeThis32chars!!

# Strapi
STRAPI_URL=http://localhost:1337
STRAPI_ADMIN_JWT_SECRET=changeMe32CharsLongSecretForJWT!
STRAPI_APP_KEYS=key1changeMe,key2changeMe
STRAPI_API_TOKEN_SALT=changeMeSaltString

# Login App
LOGIN_APP_URL=http://localhost:8001

# BBF
BBF_URL=http://localhost:8000

# Strapi Service Token (fill after creating in Strapi Admin)
STRAPI_SERVICE_TOKEN=